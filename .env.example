# Optional settings for the server. Copy this file to ".env" (which is kept out of git) and remove the
# "#" in front of a line to use it. Everything here can be left alone: the keys are normally pasted into
# Settings -> Admin in the app instead, and are then kept in the data folder.

# The port the app is served on.
# PORT=4477

# Where the database, uploads and secret keys are kept. Back this folder up.
# CHATTERDAY_DATA=C:\somewhere\else\data

# Who the server listens to. The default is this PC plus its Tailscale address.
#   lan = also the home network      all = everything (only for a port-forward setup; avoid it)
# CHATTERDAY_BIND=lan

# The first of LiveKit's three ports (voice and video). The next two are used as well.
# CHATTERDAY_LK_PORT=7880

# Keys, if you would rather keep them here than in Settings -> Admin.
# GIPHY_KEY=
# YOUTUBE_KEY=

# The house's clock (night and day in the yard, birthdays, holidays, the log's times), as an IANA zone name.
# The default is this PC's own zone. A zone picked in Settings -> Admin (or a weather town's) comes first.
# CHATTERDAY_TZ=Europe/Berlin

# The address LiveKit tells friends' apps to send voice and video to. Normally worked out by itself;
# set it only if voice connects but nobody can hear each other.
# LIVEKIT_NODE_IP=100.x.y.z

# Where the desktop installers offered in Settings -> Admin are found. The default is desktop\dist.
# CHATTERDAY_INSTALLERS=C:\somewhere\installers
